# Public values only. The frontend never holds service-role keys.
# Base URL of the Supabase project's edge functions, e.g. https://<project-ref>.supabase.co/functions/v1
VITE_FUNCTIONS_URL=
# Publishable (anon) key. Only used as the Authorization header for edge function calls.
VITE_SUPABASE_ANON_KEY=
